# ==========================================
# CORE DJANGO
# ==========================================
DEBUG=True
SECRET_KEY=generate-a-random-secret-key-here

# ==========================================
# BASE DE DATOS (PostgreSQL Docker)
# ==========================================
# Host 'db' para comunicación dentro de los contenedores Docker
DATABASE_URL=postgres://admin:admin@db:5432/backend_db
# Si ejecutas comandos directamente desde tu venv local en Windows, usa localhost:
# DATABASE_URL=postgres://admin:admin@localhost:5432/backend_db

# ==========================================
# INTELIGENCIA ARTIFICIAL & LLMs
# ==========================================
# Feature flag para el nuevo core de IA V2 (Groq Whisper + Gemini LiteLLM)
# False: usa pipeline piloto con Whisper local en el worker
# True: usa pipeline remoto de bajo consumo de recursos
AI_CORE_V2_ENABLED=False

# Credenciales de proveedores (obtenidas exclusivamente desde variables de entorno)
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=gsk-your-groq-api-key-here

# Configuración de Modelos AI Core V2 (opcionales)
AI_DEFAULT_LLM_MODEL=gemini/gemini-2.0-flash
AI_FALLBACK_LLM_MODEL=gpt-4o-mini
AI_DEFAULT_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ==========================================
# STORAGE (Cloudflare R2)
# ==========================================
# USE_S3=False bypasses R2 and uses local filesystem (recommended for dev)
USE_S3=False
# Completar solo si USE_S3=True:
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_REGION=auto
# CLOUDFLARE_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# ==========================================
# INTEGRATIONS (optional)
# ==========================================
# AYRSHARE_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
