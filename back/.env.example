# ==========================================
# CORE DJANGO
# ==========================================
DEBUG=True
SECRET_KEY=generate-a-random-secret-key-here

# ==========================================
# BASE DE DATOS (PostgreSQL Docker)
# ==========================================
# Host 'db' para comunicación dentro de los contenedores Docker
DATABASE_URL=postgres://admin:admin@db:5432/backend_db
# Si ejecutas comandos directamente desde tu venv local en Windows, usa localhost:
# DATABASE_URL=postgres://admin:admin@localhost:5432/backend_db

# ==========================================
# INTELIGENCIA ARTIFICIAL & LLMs
# ==========================================
# Feature flag: True activa AI Core V2 (Groq Whisper + LiteLLM Gemini)
AI_CORE_V2_ENABLED=False

# Gemini — proveedor primario para clip selection, SEO, y fallback LLM
GEMINI_API_KEY=your-gemini-api-key-here

# Groq — transcripción remota (Whisper Large V3 Turbo)
GROQ_API_KEY=gsk-your-groq-api-key-here

# xAI (Grok) — backup opcional para LLM vía LiteLLM
XAI_API_KEY=xai-your-xai-api-key-here

# OpenAI — Moderation API (AI_Security_Shield); opcional: fallback LLM cross-provider
OPENAI_API_KEY=sk-your-openai-api-key-here

# Configuración de Modelos (opcionales — tienen defaults en settings)
AI_DEFAULT_LLM_MODEL=gemini/gemini-3.8-flash
# Temporary same-provider fallback (Gemini). Objective: cross-provider; candidate
# groq/openai/gpt-oss-120b, gated by the org's real Groq TPM limits.
AI_FALLBACK_LLM_MODEL=gemini/gemini-3.5-flash-lite
# Timeout por llamada LLM (segundos) y tope de caracteres del transcript enviado al LLM
AI_LLM_TIMEOUT_SECONDS=60
AI_LLM_MAX_TRANSCRIPT_CHARS=400000
AI_DEFAULT_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Backend de transcripción con AI_CORE_V2_ENABLED=True: groq (default) | local (solo dev/rollback)
TRANSCRIPTION_BACKEND=groq

# ==========================================
# STORAGE (Cloudflare R2)
# ==========================================
# USE_R2=False bypasses R2 and uses local filesystem (recommended for dev)
USE_R2=False
# Completar solo si USE_R2=True:
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_REGION=auto
# CLOUDFLARE_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# ==========================================
# INTEGRATIONS (optional)
# ==========================================
# AYRSHARE_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
