# ==========================================
# CORE DJANGO
# ==========================================
DEBUG=True
SECRET_KEY=generate-a-random-secret-key-here

# ==========================================
# BASE DE DATOS (PostgreSQL Docker)
# ==========================================
DATABASE_URL=postgres://admin:admin@db:5432/backend_db

# ==========================================
# INTELIGENCIA ARTIFICIAL & LLMs
# ==========================================
# Feature flag: True activa AI Core V2 (Groq Whisper + LiteLLM Gemini)
AI_CORE_V2_ENABLED=False

# Gemini — proveedor primario para clip selection, SEO, y fallback LLM
GEMINI_API_KEY=your-gemini-api-key-here

# Groq — transcripción remota (Whisper Large V3 Turbo)
GROQ_API_KEY=gsk-your-groq-api-key-here

# OpenAI — SOLO para Moderation API gratuita (AI_Security_Shield)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Configuración de Modelos (opcionales — tienen defaults en settings)
AI_DEFAULT_LLM_MODEL=gemini/gemini-2.0-flash
AI_FALLBACK_LLM_MODEL=gemini/gemini-1.5-flash
AI_DEFAULT_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ==========================================
# STORAGE (Cloudflare R2)
# ==========================================
USE_S3=False
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_REGION=auto

# ==========================================
# INTEGRATIONS (optional)
# ==========================================
# AYRSHARE_API_KEY=
