# ==========================================
# CORE DJANGO
# ==========================================
DEBUG=True
SECRET_KEY=generate-a-random-secret-key-here

# ==========================================
# BASE DE DATOS (PostgreSQL Docker)
# ==========================================
# Host 'db' para comunicación dentro de los contenedores Docker
DATABASE_URL=postgres://admin:admin@db:5432/backend_db
# Si ejecutas comandos directamente desde tu venv local en Windows, usa localhost:
# DATABASE_URL=postgres://admin:admin@localhost:5432/backend_db

# ==========================================
# REDIS / VALKEY (broker de Celery, locks y cache)
# ==========================================
# docker-compose.yml define las dos para web y worker. Fuera de Docker, apuntalas a tu Redis.
# Broker y result backend de Celery, lock por proyecto y buckets de capacidad:
# REDIS_URL=redis://redis:6379/0
# Cache de Django (django-redis): lista pública de planes, límites de intentos y el lock
# de cada publicación, compartidos por todos los procesos. Siempre otra base que la del
# broker: cache.clear() hace FLUSHDB de toda la base. Sin CACHE_REDIS_URL la cache es una
# LocMem por proceso, que no sirve con varios workers de gunicorn o contenedores (prod lo
# avisa con cache.not_shared; la misma base que el broker, con cache.shares_broker_db).
# CACHE_REDIS_URL=redis://redis:6379/1
# Prefijo de las claves de la cache: distinto si dos entornos usan el mismo Redis
# CACHE_KEY_PREFIX=onecreator

# ==========================================
# INTELIGENCIA ARTIFICIAL & LLMs
# ==========================================
# Feature flag: True activa AI Core V2 (Groq Whisper + LiteLLM Gemini)
AI_CORE_V2_ENABLED=False
# Piloto (AICORE-9): ids de usuario (UUID, separados por coma) que usan V2 con el
# flag en True. Vacío = todos. Con el flag en False nadie usa V2 (kill switch).
AI_CORE_V2_ALLOWLIST=
# Nivel de razonamiento del LLM de selección: minimal | low | medium | high (vacío = default del proveedor)
AI_LLM_REASONING_EFFORT=
# Largo máximo del pedido de Prompt-to-Edit (PTE-01a)
AI_PROMPT_MAX_CHARS=1000

# Gemini — proveedor primario para clip selection, SEO, y fallback LLM
GEMINI_API_KEY=your-gemini-api-key-here

# Groq — transcripción remota (Whisper Large V3 Turbo)
GROQ_API_KEY=gsk-your-groq-api-key-here

# xAI (Grok) — backup opcional para LLM vía LiteLLM
XAI_API_KEY=xai-your-xai-api-key-here

# OpenAI — Moderation API (AI_Security_Shield); opcional: fallback LLM cross-provider
OPENAI_API_KEY=sk-your-openai-api-key-here
# Moderación (ADR-011): modelo fijo, tamaño de bloque y categorías que se miden pero no bloquean
MODERATION_MODEL=omni-moderation-latest
MODERATION_BLOCK_CHARS=10000
MODERATION_NON_BLOCKING_CATEGORIES=harassment,violence,self-harm,illicit

# Configuración de Modelos (opcionales — tienen defaults en settings)
AI_DEFAULT_LLM_MODEL=gemini/gemini-3.8-flash
# Temporary same-provider fallback (Gemini). Objective: cross-provider; candidate
# groq/openai/gpt-oss-120b, gated by the org's real Groq TPM limits.
AI_FALLBACK_LLM_MODEL=gemini/gemini-3.5-flash-lite
# Timeout por llamada LLM (segundos) y tope de caracteres del transcript enviado al LLM
AI_LLM_TIMEOUT_SECONDS=60
# Razonamiento del LLM de selección (ADR-012): minimal | low | medium | high; vacío = default del proveedor
AI_LLM_REASONING_EFFORT=
AI_LLM_MAX_TRANSCRIPT_CHARS=400000
# Límites de cada clip (AICORE-16): duración objetivo en segundos, tolerancia para
# ajustar inicio/fin a palabras y pausa mínima que cuenta como corte natural
AI_CLIP_MIN_SECONDS=15
AI_CLIP_MAX_SECONDS=60
AI_CLIP_SNAP_TOLERANCE_SECONDS=1.0
AI_CLIP_PAUSE_SECONDS=0.5
AI_DEFAULT_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Timeout de cada request a Groq, o sea de un chunk de audio (segundos); conectar
# tiene 5 s. Sin reintentos del SDK: el provider reintenta el chunk ante 429, 5xx
# o conexión, y un timeout lo reintenta Celery
AI_TRANSCRIPTION_TIMEOUT_SECONDS=120
# Backend de transcripción con AI_CORE_V2_ENABLED=True: groq (default) | local (solo dev/rollback)
TRANSCRIPTION_BACKEND=groq
# Whisper local (backend legacy o TRANSCRIPTION_BACKEND=local), CORE-04:
# dispositivo auto | cpu | cuda (fp16 solo en cuda), precarga una vez por proceso
# del worker y tamaño del modelo (tiny, base, small, medium, large)
TRANSCRIPTION_DEVICE=auto
WHISPER_PRELOAD=True
WHISPER_LOCAL_MODEL_SIZE=base
# Reciclaje de procesos del worker: tras N tareas, o tras la tarea en la que
# superó este uso de memoria en KiB (0 = sin tope de memoria)
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
CELERY_WORKER_MAX_MEMORY_PER_CHILD=0
# Vista previa de clips (PTE-03): alto en píxeles, vida en segundos desde que
# está lista, y cuántas puede haber en proceso a la vez por espacio de trabajo
PREVIEW_HEIGHT=360
PREVIEW_TTL_SECONDS=3600
PREVIEW_MAX_ACTIVE_PER_WORKSPACE=3
# Logs (INFRA-02): json (una línea JSON por evento, para producción) | text (consola legible).
# En dev el default es text. LOG_SERVICE etiqueta cada línea: web, worker o beat.
LOG_FORMAT=text
LOG_LEVEL=INFO
LOG_SERVICE=
# Alerta cuando una tarea Celery falla N veces seguidas (0 = apagada), por mail a ADMIN_EMAILS
TASK_FAILURE_ALERT_THRESHOLD=3
ADMIN_EMAILS=
# Tope por corrida de ingestión en segundos (soft: falla el proyecto y libera el lock;
# hard: mata el worker). Ambos menores que CELERY_VISIBILITY_TIMEOUT (4 h por defecto).
PIPELINE_SOFT_TIME_LIMIT=7200
PIPELINE_TIME_LIMIT=7500
# Tope del render del paper edit en segundos (soft: falla el proyecto y devuelve
# la reserva del render; hard: mata el worker). Ambos menores que CELERY_VISIBILITY_TIMEOUT.
RENDER_SEGMENTS_SOFT_TIME_LIMIT=10800
RENDER_SEGMENTS_TIME_LIMIT=11100
# Renders de un clip que empezaron y no terminaron (su worker murió, por ejemplo
# por OOM), contando el que va a empezar. Pasado este número el clip falla en
# lugar de volver para siempre. Los reintentos por errores transitorios no cuentan.
# Mínimo 2: con 1, un solo corte del broker fallaría un clip sano.
RENDER_CLIP_MAX_STARTS=3
# Tope del render de un clip en segundos (soft: el clip falla y suelta su claim;
# hard: mata el worker y recover_stuck_renders toma el clip).
RENDER_CLIP_SOFT_TIME_LIMIT=7200
RENDER_CLIP_TIME_LIMIT=7500
# Peor caso de segundos de render por segundo de clip: la aprobación rechaza un
# segmento más largo que RENDER_CLIP_SOFT_TIME_LIMIT / esto (1800 s por defecto).
RENDER_CLIP_SECONDS_PER_SECOND=4.0
# Un render con la reserva tomada, sin lock y sin empezar en estos segundos está
# trabado (recover_stuck_renders). Nunca menos que el hard limit mayor
# (RENDER_SEGMENTS_TIME_LIMIT o RENDER_CLIP_TIME_LIMIT) + 900, que es el default:
# un valor menor se ignora.
# RENDER_STUCK_AFTER_SECONDS=
# Límites del pipeline para un archivo subido (se miden con ffprobe antes de guardarlo)
AI_UPLOAD_MAX_DURATION_SECONDS=10800
AI_UPLOAD_MAX_LONG_SIDE_PX=4096
AI_UPLOAD_MIN_SHORT_SIDE_PX=240
AI_SINGLE_EDIT_MAX_DURATION_SECONDS=600

# Plan con el que empieza un workspace nuevo (lo siembran las migraciones de payments).
# Si no existe o está inactivo, el workspace queda sin plan y queda en el log (plans.default_plan_*).
DEFAULT_PLAN_NAME=Gratis

# Rate limiting propio (AICORE-11, ADR-012 D-C4): token buckets en Valkey antes de
# cada llamada a Groq o al LLM. Apagado por defecto; en piloto y producción va en True.
AI_CAPACITY_ENABLED=False
# JSON con un bucket por modelo y recurso: audio_seconds | tokens | requests, por
# minute | hour | day. Valores al 80 % del límite que muestra la consola del proveedor.
# Con el flag en True, todo modelo que llame el pipeline (primario, fallback y
# Whisper) necesita su entrada. Runbook del piloto, sección 5.5.
# Groq: 80 % de lo relevado el 2026-10-11 (7.200 s/h, 28.800 s/día, 20 RPM, 2.000 RPD).
# Gemini: valores de EJEMPLO; reemplazar por el 80 % de la consola del tier pago.
AI_CAPACITY_LIMITS={"groq/whisper-large-v3-turbo":{"audio_seconds_per_hour":5760,"audio_seconds_per_day":23040,"requests_per_minute":16,"requests_per_day":1600},"gemini/gemini-3.8-flash":{"tokens_per_minute":160000,"requests_per_minute":400},"gemini/gemini-3.5-flash-lite":{"tokens_per_minute":160000,"requests_per_minute":400}}
# Espera máxima por capacidad de una etapa antes de fallar el proyecto, y tope de
# cada countdown de re-encolado (segundos)
AI_CAPACITY_MAX_WAIT_SECONDS=3600
AI_CAPACITY_MAX_COUNTDOWN_SECONDS=300

# Metadata social por publicación (AICORE-17, ADR-013): idioma del caption y
# límite de caption + hashtags por plataforma
AI_SEO_LANGUAGE=es
AI_SEO_CAPTION_MAX_CHARS={"TIKTOK":2200,"INSTAGRAM_REELS":2200,"YOUTUBE_SHORTS":5000}

# ==========================================
# SESIÓN Y LÍMITES DE INTENTOS
# ==========================================
# Proxies delante de Django (load balancer, nginx) que agregan la IP del cliente
# a X-Forwarded-For. Obligatorio en producción (prod.py no arranca sin él):
# 1 detrás de un solo nginx, 2 con un load balancer y nginx, 0 si Django recibe
# los pedidos directo. Con un número menor al real todos comparten la IP del
# proxy; con uno mayor, el cliente puede inventar la suya. En dev el default es 0.
NUM_PROXIES=0
# Límites de intentos (DRF): "<cantidad>/<s|min|hour|day>". Por IP sin sesión,
# por usuario con sesión. Un valor mal escrito no deja arrancar la app.
THROTTLE_LOGIN=10/min
THROTTLE_TOKEN_REFRESH=30/min
THROTTLE_PASSWORD_CHANGE=5/hour
THROTTLE_EMAIL_CHANGE=5/hour
# Logins fallidos de una cuenta: solo cuentan los fallidos y un login correcto
# los reinicia. "<cantidad>/<ventana>", la ventana con un número delante
# ("10/15m" = 10 cada 15 minutos). Desde una IP y desde cualquier IP.
LOGIN_FAILURES_PER_ACCOUNT_IP=10/15m
LOGIN_FAILURES_PER_ACCOUNT=100/h

# ==========================================
# MANTENIMIENTO (página K5 de la web)
# ==========================================
# Prendido: /api/v1/status/ lo informa y el resto de /api/ responde 503.
MAINTENANCE_MODE=False
# Ventana estimada, ISO 8601 (UTC si no tiene zona); se informa si están las dos.
# MAINTENANCE_STARTS_AT=2026-11-24T02:00:00Z
# MAINTENANCE_ENDS_AT=2026-11-24T03:30:00Z
# Rutas que siguen andando (webhooks, health checks), separadas por coma.
# MAINTENANCE_EXEMPT_PATHS=/api/v1/webhooks/,/api/health/

# ==========================================
# EMAILS A USUARIOS (verificación del email nuevo, alertas a ADMIN_EMAILS)
# ==========================================
# En producción prod.py no arranca sin FRONTEND_URL, DEFAULT_FROM_EMAIL y, con
# SMTP, EMAIL_HOST. En dev los emails salen por consola (settings/dev.py).
# Origen de la web: los links del email abren FRONTEND_URL/verificar.
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=OneCreator <no-reply@onecreator.local>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.ejemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# Segundos que puede tardar el servidor SMTP antes de que el pedido falle
# EMAIL_TIMEOUT=10
# Vida del link de verificación del email nuevo, en segundos (24 h)
EMAIL_VERIFICATION_MAX_AGE_SECONDS=86400

# ==========================================
# STORAGE (Cloudflare R2)
# ==========================================
# USE_R2=False bypasses R2 and uses local filesystem (recommended for dev)
USE_R2=False
# Completar solo si USE_R2=True:
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_REGION=auto
# CLOUDFLARE_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# ==========================================
# INTEGRATIONS (optional)
# ==========================================
# AYRSHARE_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
