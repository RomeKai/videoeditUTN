# URL del backend Django (sin barra final). Se usa cuando los mocks están apagados.
NEXT_PUBLIC_API_URL=http://localhost:8000
# true: MSW responde todo en el navegador (modo mock, por defecto en dev). false: habla con el backend real.
# NEXT_PUBLIC_API_MODE=mock|hybrid|real manda sobre esta variable (ver .env.example).
NEXT_PUBLIC_API_MOCKS=true
