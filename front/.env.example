# URL del backend Django (sin barra final). Se usa en los modos real e hybrid.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Quién responde la API:
#   mock    MSW responde todo en el navegador (por defecto en dev).
#   real    la app habla con el backend para todo; MSW no arranca.
#   hybrid  el backend responde una parte y MSW el resto (ver "Modo híbrido" en el README).
NEXT_PUBLIC_API_MODE=mock

# Solo en hybrid: qué va al backend real, separado por comas. Acepta dominios del contrato
# (users, workspaces, projects, clips, brandkits, billing, social, notifications, system),
# ids de endpoint (billing.plans) y la palabra "existing".
#   vacío                   lo que el contrato marca exists o partial
#   projects,brandkits      esos dominios enteros (también lo que todavía es proposed)
#   existing,users.me       lo existente más ese endpoint
# auth va siempre al backend en hybrid: no hace falta nombrarlo.
NEXT_PUBLIC_API_REAL=

# Variable anterior, sigue funcionando cuando no está NEXT_PUBLIC_API_MODE:
# true = mock, false = real.
# NEXT_PUBLIC_API_MOCKS=true
